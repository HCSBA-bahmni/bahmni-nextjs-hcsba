NEXT_PUBLIC_OPENMRS_BASE=/openmrs
NEXT_PUBLIC_CONFIG_BASE=/bahmni_config/openmrs/apps
NEXT_PUBLIC_IMPLEMENTATION_CONFIG_BASE=/implementation_config/openmrs/apps
NEXT_PUBLIC_I18N_BASE=/bahmni_config/openmrs/i18n
NEXT_PUBLIC_IMPLEMENTATION_I18N_BASE=/implementation_config/openmrs/i18n
NEXT_PUBLIC_LEGACY_BAHMNI_BASE=/bahmni
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_CLINICAL_CONSULTATION_ENABLED=false
# IPS sólo se habilita cuando estas rutas apuntan a un mediador same-origin que
# resuelve autenticación del lado servidor. Nunca configure credenciales aquí.
NEXT_PUBLIC_IPS_ENABLED=false
NEXT_PUBLIC_IPS_PDQM_BASE=/openmrs/ips-mediator/pdqm
NEXT_PUBLIC_IPS_REGIONAL_BASE=/openmrs/ips-mediator/regional
NEXT_PUBLIC_IPS_VHL_GENERATE_PATH=/openmrs/ips-mediator/vhl/_generate
NEXT_PUBLIC_IPS_VHL_RESOLVE_PATH=/openmrs/ips-mediator/vhl/_resolve
NEXT_PUBLIC_ICVP_FROM_BUNDLE_PATH=/openmrs/ips-mediator/icvpcert/_from-bundle
